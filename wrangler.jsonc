{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier-vert",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
